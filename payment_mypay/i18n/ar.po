#. module: payment_mypay
#: model:ir.model.fields,field_description:payment_mypay.field_payment_provider__mypay_client_id
msgid "Client ID"
msgstr "معرف العميل"

#. module: payment_mypay
#: model:ir.model.fields,help:payment_mypay.field_payment_provider__mypay_client_id
msgid "The Client ID provided in the MyPay merchant dashboard."
msgstr "معرف العميل من لوحة تحكم تاجر MyPay."

#. module: payment_mypay
#: model:ir.model.fields,field_description:payment_mypay.field_payment_provider__mypay_secret_id
msgid "Secret ID"
msgstr "المفتاح السري"

#. module: payment_mypay
#: model:ir.model.fields,help:payment_mypay.field_payment_provider__mypay_secret_id
msgid "The Secret ID provided in the MyPay merchant dashboard."
msgstr "المفتاح السري من لوحة تحكم تاجر MyPay."

#. module: payment_mypay
#: model:ir.model.fields,field_description:payment_mypay.field_payment_provider__mypay_webhook_secret
msgid "Webhook Secret"
msgstr "سر الويب هوك"

#. module: payment_mypay
#: model:ir.model.fields,help:payment_mypay.field_payment_provider__mypay_webhook_secret
msgid ""
"Optional. Used to verify X-MyPay-Signature on incoming webhooks. "
"Payment confirmation still works via Payment Status enquiry without "
"a public HTTPS webhook endpoint."
msgstr ""
"اختياري. يُستخدم للتحقق من X-MyPay-Signature على الإشعارات الواردة. "
"تأكيد الدفع يعمل عبر استعلام Payment Status دون الحاجة إلى "
"نقطة ويب هوك عامة على HTTPS."

#. module: payment_mypay
#: model:ir.model.fields,field_description:payment_mypay.field_payment_provider__mypay_webhook_url
msgid "Webhook URL"
msgstr "رابط الويب هوك"

#. module: payment_mypay
#: model:ir.model.fields,help:payment_mypay.field_payment_provider__mypay_webhook_url
msgid ""
"Optional. Paste this URL in the MyPay merchant dashboard under API "
"Credentials → Webhook when a public HTTPS URL is available."
msgstr ""
"اختياري. الصق هذا الرابط في لوحة MyPay ضمن بيانات اعتماد API ← Webhook "
"عند توفر عنوان HTTPS عام."

#. module: payment_mypay
#: model:ir.model.fields,field_description:payment_mypay.field_payment_provider__mypay_webhook_is_https
msgid "Webhook URL uses HTTPS"
msgstr "رابط الويب هوك يستخدم HTTPS"

#. module: payment_mypay
#: model:ir.model.fields,field_description:payment_mypay.field_payment_provider__mypay_webhook_reachability_warning
msgid "Webhook Reachability Warning"
msgstr "تحذير وصول الويب هوك"

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_provider.py:0
msgid ""
"Inbound MyPay webhooks need a public HTTPS web.base.url. Payments can "
"still be confirmed via Payment Status enquiry and the return URL. "
"Optional: use a reverse proxy or tunnel, then update "
"Settings → System Parameters → web.base.url."
msgstr ""
"تحتاج إشعارات MyPay الواردة إلى web.base.url عام على HTTPS. يمكن تأكيد "
"المدفوعات عبر استعلام Payment Status ورابط العودة. اختياري: استخدم وكيلاً "
"عكسياً أو نفقاً، ثم حدّث الإعدادات ← معاملات النظام ← web.base.url."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_provider.py:0
msgid ""
"MyPay cannot reach localhost for webhooks. Payments can still be "
"confirmed via Payment Status enquiry. Optional: expose Odoo with a "
"public HTTPS URL (Cloudflare Tunnel or reverse proxy)."
msgstr ""
"لا يستطيع MyPay الوصول إلى localhost للويب هوك. يمكن تأكيد المدفوعات عبر "
"استعلام Payment Status. اختياري: اجعل أودو متاحاً عبر HTTPS عام "
"(Cloudflare Tunnel أو وكيل عكسي)."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_provider.py:0
msgid "A payment token or custom reference is required for status enquiry."
msgstr "يلزم رمز الدفع أو المرجع المخصص لاستعلام الحالة."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_provider.py:0
msgid "Payment status not found in the API response."
msgstr "لم يتم العثور على حالة الدفع في استجابة واجهة برمجة التطبيقات."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_provider.py:0
msgid ""
"Multiple payments match this custom reference. "
"Retry the status enquiry with the payment token "
"(provider reference)."
msgstr ""
"عدة مدفوعات تطابق هذا المرجع المخصص. "
"أعد استعلام الحالة باستخدام رمز الدفع "
"(مرجع المزود)."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_provider.py:0
msgid "Could not establish the connection to the API."
msgstr "تعذر الاتصال بواجهة برمجة التطبيقات."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_provider.py:0
msgid "The communication with the API failed: %s"
msgstr "فشل الاتصال بواجهة برمجة التطبيقات: %s"

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_provider.py:0
msgid "The API returned an invalid response."
msgstr "أعادت واجهة برمجة التطبيقات استجابة غير صالحة."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_provider.py:0
msgid "The Client ID and Secret ID are required."
msgstr "معرف العميل والمفتاح السري مطلوبان."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_provider.py:0
msgid "Access token not found in the API response."
msgstr "لم يتم العثور على رمز الوصول في استجابة واجهة برمجة التطبيقات."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_provider.py:0
msgid "Payment URL or token not found in the API response."
msgstr "لم يتم العثور على رابط الدفع أو الرمز في استجابة واجهة برمجة التطبيقات."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_transaction.py:0
msgid "No transaction found matching reference %s."
msgstr "لم يتم العثور على معاملة تطابق المرجع %s."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_transaction.py:0
msgid "Paid with MyPay (%s)."
msgstr "تم الدفع عبر MyPay (%s)."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_transaction.py:0
msgid "Paid with MyPay (status enquiry)."
msgstr "تم الدفع عبر MyPay (استعلام الحالة)."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_transaction.py:0
msgid "Received data with invalid amount."
msgstr "تم استلام بيانات بمبلغ غير صالح."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_transaction.py:0
msgid ""
"The amount of notification %(notification_amount)s does not match the "
"transaction amount %(tx_amount)s."
msgstr ""
"مبلغ الإشعار %(notification_amount)s لا يطابق مبلغ المعاملة %(tx_amount)s."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/payment_transaction.py:0
msgid ""
"The currency of notification %(notification_currency)s does not match the "
"transaction currency %(tx_currency)s."
msgstr ""
"عملة الإشعار %(notification_currency)s لا تطابق عملة المعاملة %(tx_currency)s."

#. module: payment_mypay
#: model:ir.cron,name:payment_mypay.cron_mypay_sync_pending_transactions
msgid "MyPay: sync pending payment status"
msgstr "MyPay: مزامنة حالة المدفوعات المعلّقة"

