#. module: payment_mypay
#: model:ir.model.fields,field_description:payment_mypay.field_mypay_checkout_wizard__phone
msgid "Customer Phone"
msgstr "هاتف العميل"

#. module: payment_mypay
#: model:ir.model.fields,help:payment_mypay.field_mypay_checkout_wizard__phone
msgid ""
"Libyan mobile number required by MyPay Auto-Submit "
"(e.g. 0912345678). Without it, MyPay shows all gateways."
msgstr ""
"رقم جوال ليبي مطلوب لتفعيل الإرسال التلقائي في MyPay "
"(مثل 0912345678). بدونه تعرض MyPay كل البوابات."

#. module: payment_mypay
#: model_terms:ir.ui.view,arch_db:payment_mypay.mypay_checkout_wizard_view_form
msgid "Open MyPay"
msgstr "فتح MyPay"

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/wizard/mypay_checkout_wizard.py:0
msgid ""
"Enter a valid Libyan mobile number (09xxxxxxxx). MyPay needs it with the"
" gateway alias to skip the gateway selection page."
msgstr ""
"أدخل رقم جوال ليبي صالحاً (09xxxxxxxx). MyPay تحتاجه مع alias البوابة"
" لتجاوز صفحة اختيار كل البوابات."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/wizard/mypay_checkout_wizard.py:0
msgid "Select a MyPay gateway (moamalat, edfali, …)."
msgstr "اختر بوابة MyPay (moamalat، edfali، …)."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/account_move.py:0
msgid ""
"MyPay checkout is only available for posted customer invoices with a residual"
" amount, when the MyPay provider is enabled or in test mode."
msgstr ""
"دفع MyPay متاح فقط لفواتير العملاء المرحّلة ذات الرصيد المتبقي، عندما يكون مزوّد"
" MyPay مفعّلاً أو في وضع الاختبار."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/models/account_move.py:0
msgid ""
"Online payment is disabled. Enable portal payments in Accounting settings,"
" then try again."
msgstr ""
"الدفع عبر الإنترنت معطّل. فعّل مدفوعات البوابة في إعدادات المحاسبة ثم أعد المحاولة."

#. module: payment_mypay
#: model:ir.model,name:payment_mypay.model_account_move
msgid "Journal Entry"
msgstr "قيد يومية"

#. module: payment_mypay
#: model:ir.model.fields,field_description:payment_mypay.field_mypay_checkout_wizard__move_id
msgid "Invoice"
msgstr "فاتورة"

#. module: payment_mypay
#: model:ir.model.fields,field_description:payment_mypay.field_mypay_checkout_wizard__amount
msgid "Amount"
msgstr "المبلغ"

#. module: payment_mypay
#: model_terms:ir.ui.view,arch_db:payment_mypay.mypay_checkout_wizard_view_form
msgid "Cancel"
msgstr "إلغاء"

#. module: payment_mypay
#: model_terms:ir.ui.view,arch_db:payment_mypay.mypay_checkout_wizard_view_form
msgid ""
"Selecting a gateway sends its MyPay alias (e.g. sahary-pay) with a Libyan"
" phone so checkout skips the all-gateways page."
msgstr ""
"اختيار البوابة يرسل alias الخاص بها في MyPay (مثل sahary-pay) مع هاتف ليبي"
" حتى يتجاوز الدفع صفحة عرض كل البوابات."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/wizard/mypay_checkout_wizard.py:0
msgid "Amount must be positive and not greater than the invoice residual."
msgstr "يجب أن يكون المبلغ موجباً وألا يتجاوز الرصيد المتبقي للفاتورة."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/wizard/mypay_checkout_wizard.py:0
msgid "No MyPay provider is enabled for this company."
msgstr "لا يوجد مزوّد MyPay مفعّل لهذه الشركة."

#. module: payment_mypay
#. odoo-python
#: code:addons/payment_mypay/wizard/mypay_checkout_wizard.py:0
msgid "MyPay did not return a payment URL."
msgstr "لم تُرجع MyPay رابط دفع."
