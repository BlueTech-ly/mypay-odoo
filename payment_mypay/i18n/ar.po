msgstr "الدفع عبر MyPay"

#. module: payment_mypay
#: model:ir.model,name:payment_mypay.model_mypay_checkout_wizard
msgid "Pay invoice via MyPay gateway"
msgstr "دفع الفاتورة عبر بوابة MyPay"

#. module: payment_mypay
#: model:ir.model.fields,field_description:payment_mypay.field_mypay_checkout_wizard__payment_method_id
