    <record id="payment_method_mypay" model="payment.method">
        <field name="name">MyPay</field>
        <field name="code">mypay</field>
        <field name="sequence">1000</field>
        <field name="active">False</field>
        <field name="image" type="base64" file="payment_mypay/static/src/img/mypay.png"/>
