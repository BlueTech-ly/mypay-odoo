<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">MyPay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'mypay'">
                    <div class="alert alert-warning" role="alert" colspan="2"
                         invisible="not mypay_webhook_reachability_warning">
                        <field name="mypay_webhook_reachability_warning" nolabel="1" readonly="1"
                               class="oe_inline"/>
                    </div>
                    <div class="alert alert-info" role="alert" colspan="2"
                         invisible="code != 'mypay'">
                        <p>
                            Payments are confirmed via <b>Payment Status</b> enquiry
                            (and optionally webhooks). A public HTTPS URL is only required
                            if you want inbound webhooks.
                        </p>
                    </div>
                    <field name="mypay_client_id"
                           required="code == 'mypay' and state != 'disabled'"/>
                    <field name="mypay_secret_id" password="True"
                           required="code == 'mypay' and state != 'disabled'"/>
                    <field name="mypay_webhook_secret" password="True"/>
                    <field name="mypay_webhook_url" widget="CopyClipboardChar" readonly="1"/>
                    <field name="mypay_webhook_is_https" invisible="1"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
